{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Paperview desktop access for user-selected folders and HTTPS services",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "dialog:default",
    "fs:default",
    "fs:allow-exists",
    "fs:allow-stat",
    "fs:allow-read-dir",
    "fs:allow-read-file",
    "fs:allow-read-text-file",
    "fs:allow-write-file",
    "fs:allow-write-text-file",
    "fs:allow-mkdir",
    "http:default",
    "opener:default",
    "deep-link:default"
  ]
}