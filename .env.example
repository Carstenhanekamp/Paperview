OPENAI_API_KEY=your_openai_api_key_here
VITE_OPENAI_API_KEY=
VITE_OPENAI_MODEL=gpt-5.4-mini
VITE_OPENAI_MODELS=gpt-5.4-nano,gpt-5.4-mini,gpt-5.4

# Local model via Ollama (optional — leave empty to use OpenAI)
# Switch to "local" to use Ollama instead of OpenAI
VITE_PROVIDER=openai
VITE_OLLAMA_BASE_URL=http://localhost:11434
VITE_OLLAMA_MODEL=gemma4:12b
VITE_OLLAMA_MODELS=gemma4:12b
